# Spotify OAuth Credentials
# Get these from: https://developer.spotify.com/dashboard
# 1. Create an app at https://developer.spotify.com/dashboard/applications
# 2. Add redirect URI: http://localhost:3000/api/auth/callback/spotify
NEXT_PUBLIC_CLIENT_ID=your_spotify_client_id
NEXT_PUBLIC_CLIENT_SECRET=your_spotify_client_secret

# NextAuth.js Secret
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_for_next_auth

# MongoDB Connection
# Option 1: MongoDB Atlas (free tier): https://www.mongodb.com/cloud/atlas
# Option 2: Local MongoDB: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=now_playing

# NextAuth URL (required in production)
NEXTAUTH_URL=http://localhost:3000
